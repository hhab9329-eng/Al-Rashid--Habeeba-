  <div class="eyebrow">Two Families, One Journey</div>
  <h2>With the blessings<br><em>of our families</em></h2>
  <div class="family-card">
    <div class="eyebrow">Groom</div>
    <h3>Al Rashid</h3>
    <p>Son of</p>
    <strong>Nizarudeen<br>&amp; Sheeja</strong>
