<section class="light blessing">
  <div class="eyebrow">With Love</div>
  <h2>Blessings from<br><em>family and friends</em></h2>
  <div class="portrait">🤵🏻‍♂️🤍👰🏻‍♀️</div>
  <p><em>Masha Allah!<br>Habeeba &amp; Al Rashid</em></p>
  <div class="eyebrow">With love &amp; blessings from friends and family</div>
  <hr style="border:0;border-top:1px solid #c8ad65;margin:35px auto;width:80px">
