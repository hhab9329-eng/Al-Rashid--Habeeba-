  <div class="eyebrow">The Occasion</div>
  <h2>Every detail,<br><em>thoughtfully arranged</em></h2>
  <div class="detail-card">
    <div class="detail-row">
      <div class="symbol">📅</div><div>
        <div class="label">DATE &amp; TIME</div>
        <h3>Thursday, 24 December 2026</h3>
        <p>Nikah Ceremony</p>
      </div>
    </div>
    <div class="detail-row">
      <div class="symbol">📍</div><div>
        <div class="label">VENUE</div>
        <h3>Amj Auditorium</h3>
        <p>Kanjirathummood, Kollam</p>
