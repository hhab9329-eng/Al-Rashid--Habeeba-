    </div>
    <div class="detail-row">
      <div class="symbol">🤍</div><div>
        <div class="label">WITH BLESSINGS</div>
        <h3>Our beloved families</h3>
        <p>We look forward to celebrating with you.</p>
      </div>
    </div>
  </div>
  <a class="btn" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Amj+Auditorium+Kanjirathummood+Kollam">📍 &nbsp; GET DIRECTIONS</a>
  <a class="btn outline" id="calendar" href="#">📅 &nbsp; ADD TO CALENDAR</a>
  <a class="btn outline" id="rsvp" target="_blank" rel="noopener" href="https://wa.me/?text=Assalamu%20Alaikum%2C%20I%20would%20like%20to%20RSVP%20for%20Habeeba%20and%20Al%20Rashid%27s%20Nikah%20on%2024%20December%202026.">💬 &nbsp; WHATSAPP RSVP</a>
