  <form id="wishForm">
    <input id="guestName" placeholder="Your Name" required maxlength="60">
    <textarea id="guestMessage" placeholder="Write your wishes for Habeeba & Al Rashid..." required maxlength="500"></textarea>
    <button type="submit">SEND WISHES</button>
  </form>
  <div class="eyebrow" style="margin-top:55px">Messages from loved ones</div>
  <div id="wishList"></div>
  <p style="font-size:12px;color:#85796a">Note: this demo saves wishes in this browser only. To share messages with all visitors, connect an online database.</p>
</section>

<footer>
  <div style="font-size:25px;font-style:italic">H &amp; R</div>
  <p>Made with love for Habeeba &amp; Al Rashid</p>
  <div class="eyebrow">24 · 12 · 2026</div>
</footer>

<script>
const weddingDate = new Date('2026-12-24T12:00:00');
function countdown(){
  let diff = Math.max(0, weddingDate - new Date());
  document.getElementById('days').textContent = Math.floor(diff/86400000);
  document.getElementById('hours').textContent = Math.floor(diff/3600000)%24;
  document.getElementById('minutes').textContent = Math.floor(diff/60000)%60;
  document.getElementById('seconds').textContent = Math.floor(diff/1000)%60;
}
countdown(); setInterval(countdown,1000);

const pad=n=>String(n).padStart(2,'0');
const start='20261224T120000';
const end='20261224T124500';
const eventUrl='https://calendar.google.com/calendar/render?action=TEMPLATE&text='+encodeURIComponent('Nikah: Habeeba & Al Rashid')+'&dates='+start+'/'+end+'&details='+encodeURIComponent('Nikah ceremony of Habeeba and Al Rashid')+'&location='+encodeURIComponent('Amj Auditorium, Kanjirathummood, Kollam');
document.getElementById('calendar').href=eventUrl;

const form=document.getElementById('wishForm');
const list=document.getElementById('wishList');
function loadWishes(){
  list.replaceChildren();
  const wishes=JSON.parse(localStorage.getItem('hrWishes')||'[]');
  wishes.slice().reverse().forEach(item=>{
    const card=document.createElement('div');card.className='wish';
    const h=document.createElement('h3');h.textContent=item.name;
    const p=document.createElement('p');p.textContent='“'+item.message+'”';
    card.append(h,p);list.append(card);
  });
}
form.addEventListener('submit',e=>{
  e.preventDefault();
  const wishes=JSON.parse(localStorage.getItem('hrWishes')||'[]');
  wishes.push({
    name:document.getElementById('guestName').value.trim(),
    message:document.getElementById('guestMessage').value.trim()
  });
  localStorage.setItem('hrWishes',JSON.stringify(wishes));
  form.reset();loadWishes();
});
loadWishes();
</script>
</body>
</html>
